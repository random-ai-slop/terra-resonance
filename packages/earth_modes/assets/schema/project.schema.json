{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Terra project 1.0",
  "$comment": "Wire structure only. Python/TypeScript semantic validation remains mandatory: JCS domain, IDs, array lengths, layer topology, normalization, regularity, hashes, evidence and resource/sampling limits.",
  "type": "object",
  "properties": {
    "format": {
      "const": "terra-project"
    },
    "version": {
      "const": "1.0"
    },
    "bundle": {
      "$ref": "mode-bundle.schema.json"
    },
    "scene": {
      "$ref": "scene.schema.json"
    },
    "probe": {
      "$ref": "#/$defs/probe"
    },
    "export": {
      "$ref": "#/$defs/export"
    }
  },
  "required": [
    "format",
    "version",
    "bundle",
    "scene"
  ],
  "additionalProperties": true,
  "$defs": {
    "probe": {
      "type": "object",
      "properties": {
        "latitude_deg": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude_deg": {
          "type": "number"
        },
        "radius_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1
        },
        "layer_id": {
          "type": "string",
          "minLength": 1
        },
        "start_s": {
          "type": "number",
          "minimum": 0
        },
        "step_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "sample_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "derivative": {
          "enum": [
            0,
            1,
            2
          ],
          "default": 0
        },
        "normalized": {
          "type": "boolean",
          "default": true
        }
      },
      "required": [
        "latitude_deg",
        "longitude_deg",
        "start_s",
        "step_s",
        "sample_count"
      ],
      "additionalProperties": false
    },
    "export": {
      "type": "object",
      "properties": {
        "format": {
          "enum": [
            "png",
            "svg",
            "csv",
            "frames",
            "gif",
            "mp4",
            "glb"
          ],
          "default": "png"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "default": 1200
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "default": 900
        },
        "duration_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 8
        },
        "fps": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "transparent": {
          "type": "boolean",
          "default": false
        },
        "annotation": {
          "type": "boolean",
          "default": true
        },
        "omit_arrows": {
          "type": "boolean",
          "default": false
        },
        "omit_geography": {
          "type": "boolean",
          "default": false
        },
        "omit_analysis_overlays": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "format": {
                "const": "gif"
              }
            },
            "required": [
              "format"
            ]
          },
          "then": {
            "properties": {
              "fps": {
                "enum": [
                  null,
                  1,
                  2,
                  4,
                  5,
                  10,
                  20,
                  25,
                  50
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "transparent": {
                "const": true
              }
            },
            "required": [
              "transparent"
            ]
          },
          "then": {
            "properties": {
              "format": {
                "enum": [
                  "png",
                  "svg"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
